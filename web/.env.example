# Turso (libSQL) — https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Admin API secret — any long random string, keep private
ADMIN_SECRET=change-me-to-something-random

# DMG download URL — GitHub release asset URL (private repo supported via GITHUB_TOKEN)
NOTCHDECK_DOWNLOAD_URL=https://github.com/navjotdhanawat/notchdeck/releases/latest/download/NotchDeck.dmg

# GitHub read-only token (repo scope) — allows proxying DMG from a private repo
GITHUB_TOKEN=your-github-pat-here
